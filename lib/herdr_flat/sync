#!/usr/bin/env bash
# Write the flat design tokens into every flat-* Herdr mod.
#
# Herdr won't load a mod's imports through a symlink, and dotfiles deploys
# each mod file as a symlink. So instead of a shared module, each mod's
# main.js carries the tokens in a generated block between the markers
#   // <flat-tokens> ... // </flat-tokens>
# Edit lib/herdr_flat/flat.js, then run this. `--check` only reports drift.
# Changed mods are relinked so a running Herdr reloads them.
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
SOURCE="$ROOT/lib/herdr_flat/flat.js"
MODS="$ROOT/global/.config/herdr-app/mods"

check=0
[ "${1:-}" = --check ] && check=1

block=$(
  printf '// <flat-tokens> generated by lib/herdr_flat/sync from lib/herdr_flat/flat.js; edit there\n'
  sed -n 's/^export const /const /p' "$SOURCE"
  printf '// </flat-tokens>\n'
)

status=0
for main in "$MODS"/flat-*/main.js; do
  rel=${main#"$ROOT"/}
  if ! grep -q '^// <flat-tokens>' "$main"; then
    printf 'missing token block: %s\n' "$rel" >&2
    status=1
    continue
  fi
  updated=$(BLOCK="$block" python3 -c '
import os, re, sys
text = open(sys.argv[1]).read()
print(re.sub(r"^// <flat-tokens>.*?^// </flat-tokens>\n", lambda m: os.environ["BLOCK"] + "\n", text, count=1, flags=re.S | re.M), end="")
' "$main")
  if [ "$updated" = "$(cat "$main")" ]; then
    continue
  fi
  if [ "$check" = 1 ]; then
    printf 'stale: %s\n' "$rel" >&2
    status=1
  else
    printf '%s\n' "$updated" >"$main"
    printf 'synced: %s\n' "$rel"
    "$ROOT/lib/herdr_flat/reload" "${rel#global/.config/herdr-app/}"
  fi
done
exit "$status"
