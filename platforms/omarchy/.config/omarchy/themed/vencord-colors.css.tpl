:root {
    --color00: {{ background }};
    --color01: {{ background }};
    --color02: {{ background }};
    --color03: {{ foreground }};
    --color04: {{ bright_foreground }};
    --color05: {{ bright_foreground }};
    --color06: {{ bright_foreground }};
    --color07: {{ bright_foreground }};
    --color08: {{ red }};
    --color09: {{ yellow }};
    --color10: {{ bright_yellow }};
    --color11: {{ green }};
    --color12: {{ cyan }};
    --color13: {{ blue }};
    --color14: {{ magenta }};
    --color15: {{ yellow }};
}
