zsh/.config/zsh/secrets.local.zsh
global/.config/zsh/secrets.local.zsh
global/.config/zsh/aliases/*.local.zsh
global/.config/zsh/exports/*.local.zsh
global/.config/zsh/functions/*.local.zsh
platforms/*/.config/zsh/secrets.local.zsh
platforms/*/.config/zsh/aliases/*.local.zsh
platforms/*/.config/zsh/exports/*.local.zsh
platforms/*/.config/zsh/functions/*.local.zsh

# pi: ignore all agent runtime/state, whitelist real config
pi/.pi/agent/*
!pi/.pi/agent/AGENTS.md
!pi/.pi/agent/extensions/
!pi/.pi/agent/extensions/**
!pi/.pi/agent/themes/
!pi/.pi/agent/themes/*.json
pi/.pi/agent/auth.json
pi/.pi/agent/trust.json
pi/.pi/agent/extensions/**/node_modules/
