#!/usr/bin/env bash
# Launch a coding agent in Herdr: pick a place, pick an agent, done.
# With --shell: same place picker, but the new tab is a plain shell.
#
#   Enter on an open workspace  -> new agent tab in that workspace
#   Enter on a folder           -> new agent tab in the workspace for that folder,
#                                  or a new workspace if none is open
#   Enter on a remote repo      -> clone it into $CLONE_DIR, agent in it
#   ctrl-w on any of them       -> branch picker, then a worktree for that branch:
#                                    checked out somewhere already -> reuse that checkout
#                                    only on origin -> local tracking branch, new worktree
#                                    new name       -> new branch from HEAD, new worktree
#   ctrl-r                      -> refresh the remote repo list
#   typing a path that exists   -> treated like a folder row
#   esc in a later step         -> back to the previous step
#
# The agent (and any clone) is typed into the new pane, so the popup closes
# right away and the work shows in the pane.
#
# Meant to run as a Herdr popup (see [[keys.command]] in herdr config.toml).
# Needs: fzf, jq. Optional: zoxide (folder rows), gh + fd (remote repo rows).
set -uo pipefail

HERDR=${HERDR_BIN_PATH:-herdr}
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/herdr-launch
LAST_AGENT_FILE=$STATE_DIR/last-agent
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/herdr-launch
REPOS_CACHE=$CACHE_DIR/repos
# GitHub owners whose repos show up as remote rows (space separated).
OWNERS=${HERDR_LAUNCH_OWNERS:-}
# Where remote repos get cloned, and where to look for repos you already have.
CLONE_DIR=${HERDR_LAUNCH_CLONE_DIR:-$HOME/Documents/work/repos}
LOCAL_ROOT=${HERDR_LAUNCH_LOCAL_ROOT:-$HOME/Documents/work}
HOME_SCAN_DEPTH=${HERDR_LAUNCH_HOME_DEPTH:-3}
KNOWN_AGENTS=(pi claude opencode codex gemini agy)
TAB=$'\t'
SELF=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

fail() {
  printf '\n\033[31merror:\033[0m %s\n' "$*" >&2
  if [ -t 0 ]; then
    printf '\npress any key to close' >&2
    read -rsn1 _
  fi
  exit 1
}

pretty() { local t='~'; printf '%s' "${1/#$HOME/$t}"; }
clone_url() { printf 'git@github.com:%s.git' "$1"; }

# --- workspaces and picker rows ------------------------------------------------

load_workspaces() {
  local snapshot
  snapshot=$("$HERDR" api snapshot 2>&1) || fail "herdr api snapshot failed: $snapshot"
  snapshot=$(jq -c '.result.snapshot' <<<"$snapshot")
  current_ws=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}
  [ -n "$current_ws" ] || current_ws=$(jq -r '.focused_workspace_id // ""' <<<"$snapshot")

  # One line per open workspace: id<TAB>dir<TAB>label, current workspace first.
  # A workspace's folder is its git checkout path, else its first pane's cwd.
  workspaces=$(jq -r --arg cur "$current_ws" '
    . as $s
    | [ .workspaces[]
        | . as $w
        | { id: .workspace_id, label: .label, number: .number,
            dir: (.worktree.checkout_path
                  // ([$s.panes[] | select(.workspace_id == $w.workspace_id) | .cwd][0])
                  // "") } ]
    | sort_by(if .id == $cur then -1 else .number end)
    | .[] | [.id, .dir, .label] | @tsv' <<<"$snapshot")
}

workspace_for_dir() {
  awk -F'\t' -v d="$1" '$2 == d { print $1; exit }' <<<"$workspaces"
}

# Remote repo cache: owner/name per line, most recently pushed first, minus
# archived repos and repos already cloned anywhere under $LOCAL_ROOT.
refresh_repos() {
  command -v gh >/dev/null || return 0
  local local_repos owner remote="" out
  # Fetch everything first: if any gh call fails, keep the old cache. Empty
  # counts as failed too (gh exits 0 for an unknown owner when using --json).
  for owner in $OWNERS; do
    out=$(gh repo list "$owner" --limit 2000 --no-archived --json nameWithOwner -q '.[].nameWithOwner' 2>/dev/null)
    [ -n "$out" ] || return 1
    remote+=$out$'\n'
  done
  mkdir -p "$CACHE_DIR"
  local_repos=$(fd -H -td -d4 '^\.git$' "$LOCAL_ROOT" -x git -C {//} remote get-url origin 2>/dev/null |
    sed -E 's#^(git@[^:]+:|https://[^/]+/)##; s#\.git$##')
  awk 'NR == FNR { have[$0] = 1; next } NF && !($0 in have)' \
    <(printf '%s\n' "$local_repos") <(printf '%s' "$remote") >"$REPOS_CACHE.tmp" &&
    mv "$REPOS_CACHE.tmp" "$REPOS_CACHE"
}

# fzf rows: kind<TAB>workspace-id<TAB>dir-or-repo<TAB>display
build_rows() {
  local id dir label
  while IFS=$TAB read -r id dir label; do
    [ -n "$id" ] || continue
    printf 'ws\t%s\t%s\t\033[34m●\033[0m %s  \033[90m%s\033[0m\n' "$id" "$dir" "$label" "$(pretty "$dir")"
  done <<<"$workspaces"

  # Folders that already have a workspace are covered by the rows above.
  # zoxide first (ranked by use), then a shallow scan of $HOME as a fallback for
  # folders zoxide hasn't seen, hidden ones like ~/.config included.
  {
    command -v zoxide >/dev/null && zoxide query -l 2>/dev/null
    command -v fd >/dev/null && fd -H -td -d"$HOME_SCAN_DEPTH" -E .git -E node_modules -E Library \
      -E .cache -E .Trash -E .npm -E .cargo -E .rustup -E .local --absolute-path . "$HOME" 2>/dev/null |
      sed 's#/$##'
  } | awk -F'\t' -v home="$HOME" '
    NR == FNR { seen[$2] = 1; next }
    !($0 in seen) {
      seen[$0] = 1
      shown = $0
      if (index(shown, home) == 1) shown = "~" substr(shown, length(home) + 1)
      printf "dir\t-\t%s\t  %s\n", $0, shown
    }' <(printf '%s\n' "$workspaces") -

  # Remote repos last. Skip ones already cloned into $CLONE_DIR since the cache
  # was built (e.g. by this launcher).
  [ -f "$REPOS_CACHE" ] || return 0
  local repo
  while read -r repo; do
    [ -e "$CLONE_DIR/${repo#*/}" ] && continue
    printf 'remote\t-\t%s\t\033[90m↓ %s\033[0m\n' "$repo" "$repo"
  done <"$REPOS_CACHE"
}

# Ranks rows in $1 (from build_rows) against query $2, best match first, but
# local rows (workspaces, folders) always above remote repos, which would
# otherwise win often: short dashed names score high and there are hundreds.
# Ties keep build_rows order. Empty query: everything, unranked.
rank_rows() {
  local f=$1 q=${2:-} tier
  [ -n "$q" ] || { cat "$f"; return; }
  for tier in 0 1; do
    awk -F'\t' -v OFS='\t' -v t="$tier" '($1 == "remote") == t {
      gsub(/\033\[[0-9;]*m/, "", $4); print NR, $4 }' "$f" |
      fzf --filter="$q" --delimiter="$TAB" --nth=2 --scheme=path --tiebreak=index | cut -f1
  done | awk 'FILENAME == "-" { order[++n] = $1; next } { row[FNR] = $0 }
    END { for (i = 1; i <= n; i++) print row[order[i]] }' - "$f"
}

# --- branches ------------------------------------------------------------------

# Branch rows for a local repo. Output: branch<TAB>display.
# Local branches first (newest first), then origin-only ones.
list_branches() {
  local dir=$1 local_branches
  [ "${2:-}" = fetch ] && git -C "$dir" fetch -q --prune origin >/dev/null 2>&1
  local_branches=$(git -C "$dir" for-each-ref --sort=-committerdate \
    --format='%(refname:short)%09%(worktreepath)' refs/heads)
  awk -F'\t' -v home="$HOME" '{
    shown = $2
    if (index(shown, home) == 1) shown = "~" substr(shown, length(home) + 1)
    if (shown != "") printf "%s\t%s  \033[33m● %s\033[0m\n", $1, $1, shown
    else printf "%s\t%s\n", $1, $1
  }' <<<"$local_branches"
  git -C "$dir" for-each-ref --sort=-committerdate --format='%(refname:lstrip=3)' refs/remotes/origin |
    awk -v OFS='\t' 'NR == FNR { split($0, f, "\t"); have[f[1]] = 1; next }
      $0 != "HEAD" && !($0 in have) { print $0, $0 "  \033[90morigin\033[0m" }' \
      <(printf '%s\n' "$local_branches") -
}

# Branch rows for a repo that isn't cloned yet, straight from GitHub.
# Default branch first, marked, then the rest newest commit first.
# Falls back to git ls-remote (name order) if the GitHub API call fails.
list_remote_branches() {
  local q rows def
  q='query($o:String!,$n:String!,$endCursor:String){repository(owner:$o,name:$n){
    defaultBranchRef{name} refs(refPrefix:"refs/heads/",first:100,after:$endCursor){
      pageInfo{hasNextPage endCursor} nodes{name target{...on Commit{committedDate}}}}}}'
  if rows=$(gh api graphql --paginate -f query="$q" -f o="${1%%/*}" -f n="${1#*/}" \
    --jq '.data.repository | (.refs.nodes[] | "\(.target.committedDate)\t\(.name)"), "default\t\(.defaultBranchRef.name)"' 2>/dev/null); then
    # The default branch line repeats on every page; print it once, first.
    def=$(awk -F'\t' '$1 == "default" { print $2; exit }' <<<"$rows")
    [ -n "$def" ] && printf '%s\t%s  \033[90mdefault\033[0m\n' "$def" "$def"
    awk -F'\t' -v def="$def" '$1 != "default" && $2 != def' <<<"$rows" | LC_ALL=C sort -r |
      awk -F'\t' -v OFS='\t' '{ print $2, $2 }'
    return
  fi
  git ls-remote --symref "$(clone_url "$1")" HEAD 'refs/heads/*' 2>/dev/null | awk -F'\t' '
    /^ref:/ { sub(/^ref: refs\/heads\//, "", $1); def = $1; next }
    $2 ~ /^refs\/heads\// { b = substr($2, 12); if (b != def) rest[++n] = b }
    END {
      if (def != "") printf "%s\t%s  \033[90mdefault\033[0m\n", def, def
      for (i = 1; i <= n; i++) printf "%s\t%s\n", rest[i], rest[i]
    }'
}

# Sets: mode (tab|open|create), repo, wt, dir, target_ws for $branch in $dir.
resolve_branch() {
  # herdr starts worktree actions from the repo's main checkout, not a linked one.
  repo=$(git -C "$dir" worktree list --porcelain | sed -n '1s/^worktree //p')
  git -C "$dir" check-ref-format --branch "$branch" >/dev/null 2>&1 || fail "not a valid branch name: $branch"
  if ! git -C "$dir" show-ref -q --verify "refs/heads/$branch"; then
    # Not local: if origin has it (e.g. a PR branch), track it so the worktree
    # gets origin's code instead of a new branch off HEAD.
    printf 'checking origin for %s...\n' "$branch"
    git -C "$dir" fetch -q origin "$branch" >/dev/null 2>&1
    if git -C "$dir" show-ref -q --verify "refs/remotes/origin/$branch"; then
      git -C "$dir" branch -q --track "$branch" "origin/$branch" 2>/dev/null ||
        fail "could not create $branch from origin/$branch"
    fi
  fi
  wt=$(git -C "$dir" for-each-ref --format='%(worktreepath)' "refs/heads/$branch")
  if [ -z "$wt" ]; then
    mode=create
  else
    # Git allows a branch in one worktree only, so reuse that checkout.
    target_ws=$(workspace_for_dir "$wt")
    if [ -n "$target_ws" ]; then mode=tab; else mode=open; fi
    dir=$wt
  fi
}

# --- launching -----------------------------------------------------------------

# Makes the tab/workspace for $mode and focuses it, then types $cmd into its
# pane. The pane's shell runs it once it's up, so nothing here waits.
# Tabs keep herdr's numeric label so the goto navigator shows the session title.
launch() {
  local out pane tab
  case $mode in
  create) out=$("$HERDR" worktree create --cwd "$repo" --branch "$branch" --no-focus 2>&1) || fail "$out" ;;
  open) out=$("$HERDR" worktree open --cwd "$repo" --path "$wt" --no-focus 2>&1) || fail "$out" ;;
  tab) out=$("$HERDR" tab create --workspace "$target_ws" --cwd "$dir" --no-focus 2>&1) || fail "$out" ;;
  workspace) out=$("$HERDR" workspace create --cwd "$dir" ${label:+--label "$label"} --no-focus 2>&1) || fail "$out" ;;
  esac
  pane=$(jq -r '.result.root_pane.pane_id' <<<"$out")
  tab=$(jq -r '.result.tab.tab_id' <<<"$out")
  "$HERDR" tab focus "$tab" >/dev/null 2>&1
  [ -z "$cmd" ] || out=$("$HERDR" pane run "$pane" "$cmd" 2>&1) || fail "$out"
}

# --- internal modes --------------------------------------------------------------

case ${1:-} in
--list-branches) list_branches "$2" "${3:-}"; exit 0 ;;
--list-remote-branches) list_remote_branches "$2"; exit 0 ;;
--rows) load_workspaces; [ "${2:-}" = fetch ] && refresh_repos; build_rows; exit 0 ;;
--rank) rank_rows "$2" "${3:-}"; exit 0 ;;
--after-clone)
  # Runs inside the clone's pane, in the fresh clone: make the worktree for the
  # picked branch and start the agent there (empty agent = plain shell, for
  # --shell). The caller then exits this shell, which closes the temporary clone workspace (herdr won't `workspace close` a
  # repo's main workspace while it has worktree workspaces).
  branch=$2 agent=$3
  dir=$PWD target_ws=""
  load_workspaces
  resolve_branch
  cmd=$agent
  launch
  exit 0
  ;;
esac

# --- main ------------------------------------------------------------------------

# Keep the complete picker on the chosen host: its PATH, zoxide database, Git
# credentials, caches and paths must never be replaced with the caller's values.
# Internal fzf helpers above deliberately bypass machine selection.
pick_machine() {
  [ "${HERDR_LAUNCH_SKIP_MACHINE:-}" = 1 ] && return
  local machines picked id target session remote_cmd
  machines=$("$HERDR" machine list --json 2>&1) || fail "cannot list saved Herdr machines: $machines"
  machines=$(jq -r '.[] | select(.enabled) | [.id, .label, .target, .session] | @tsv' <<<"$machines") || fail "invalid Herdr machine list"
  [ -n "$machines" ] || return
  picked=$({ printf 'local\tThis machine\t-\t-\n'; printf '%s\n' "$machines"; } |
    fzf --delimiter="$TAB" --with-nth=2 --no-sort --prompt='machine> ' \
      --border-label=' launch on ' --header='enter: select machine  ·  esc: cancel') || exit 0
  IFS=$TAB read -r id _ target session <<<"$picked"
  [ "$id" != local ] || return
  # Quote for the remote login shell (not necessarily Bash). Do not pass local
  # HERDR_SOCKET_PATH / pane IDs; HERDR_SESSION selects the saved remote session.
  remote_cmd=$(printf '%s' "$session" | sed "s/'/'\\\\''/g")
  remote_cmd="env -u HERDR_SOCKET_PATH -u HERDR_WORKSPACE_ID -u HERDR_ACTIVE_WORKSPACE_ID -u HERDR_PANE_ID HERDR_SESSION='$remote_cmd' HERDR_ENV=1 HERDR_LAUNCH_SKIP_MACHINE=1"
  remote_cmd+=' "$SHELL" -lic '\''exec herdr-launch'
  [ "${1:-}" != --shell ] || remote_cmd+=' --shell'
  remote_cmd+="'"
  ssh -t -- "$target" "$remote_cmd"
  local status=$?
  [ "$status" -eq 0 ] || fail "remote launcher failed on $target; check SSH and deploy herdr-launch there"
  exit 0
}

shell_mode=""
[ "${1:-}" = --shell ] && shell_mode=1

for bin in fzf jq; do
  command -v "$bin" >/dev/null || fail "$bin is not installed"
done

pick_machine "${1:-}"

load_workspaces
if [ ! -f "$REPOS_CACHE" ] && command -v gh >/dev/null; then
  printf 'fetching the repo list for %s (first run only)...\n' "$OWNERS"
  refresh_repos
fi

if [ -n "$shell_mode" ]; then
  title=' open shell ' what='new shell'
else
  title=' launch agent ' what='new agent'
  last_agent=$(cat "$LAST_AGENT_FILE" 2>/dev/null || true)
  agents=()
  for a in "${KNOWN_AGENTS[@]}"; do
    command -v "$a" >/dev/null || continue
    if [ "$a" = "$last_agent" ]; then agents=("$a" ${agents[@]+"${agents[@]}"}); else agents+=("$a"); fi
  done
  [ "${#agents[@]}" -gt 0 ] || fail "no supported agent found on PATH (${KNOWN_AGENTS[*]})"
fi

# Steps: where -> (branch, with ctrl-w) -> agent (skipped for --shell).
# Esc goes back one step;
# esc on the first step quits.
ROWS=$(mktemp "${TMPDIR:-/tmp}/herdr-launch.XXXXXX")
trap 'rm -f "$ROWS"' EXIT
build_rows >"$ROWS"
notice=""
command -v fd >/dev/null || notice=$'\n\033[33mfd not installed: no ~ folder scan\033[0m'
query=""
step=where
while :; do
  case $step in
  where)
    # fzf can't rank in tiers, so it only filters (--no-sort) and --rank
    # re-orders the list on every keystroke.
    rank=$(printf '%q --rank %q' "$SELF" "$ROWS")
    picked=$(rank_rows "$ROWS" "$query" | fzf --ansi --no-sort --delimiter="$TAB" --with-nth=4 \
      --print-query --expect=ctrl-w --query="$query" \
      --bind="change:reload($rank {q})" \
      --bind="ctrl-r:reload($(printf '%q --rows fetch >%q' "$SELF" "$ROWS"); $rank {q})" \
      --prompt='where> ' --border-label="$title" \
      --header="enter: $what  ·  ctrl-w: worktree  ·  ctrl-r: refresh repos  ·  esc: cancel$notice")
    [ $? -eq 130 ] && exit 0
    query=$(sed -n 1p <<<"$picked")
    key=$(sed -n 2p <<<"$picked")
    row=$(sed -n 3p <<<"$picked")

    if [ -n "$row" ]; then
      IFS=$TAB read -r kind target_ws dir _ <<<"$row"
      [ "$target_ws" = "-" ] && target_ws=""
    else
      # Nothing matched: accept a typed path.
      dir=${query/#\~/$HOME}
      [ -n "$dir" ] && [ -d "$dir" ] || continue
      dir=$(cd "$dir" && pwd -P)
      kind=dir
      target_ws=""
    fi
    if [ "$kind" != remote ]; then
      [ "$kind" = dir ] && [ -z "$target_ws" ] && target_ws=$(workspace_for_dir "$dir")
      [ -n "$dir" ] && [ -d "$dir" ] || fail "folder does not exist: $dir"
    fi

    branch=""
    if [ "$key" != ctrl-w ]; then
      step=agent
    elif [ "$kind" = remote ]; then
      step=branch
    else
      git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || fail "not a git repo: $(pretty "$dir")"
      step=branch
    fi
    ;;
  branch)
    if [ "$kind" = remote ]; then
      list_cmd=$(printf '%q --list-remote-branches %q' "$SELF" "$dir")
      btitle=" worktree from $dir (will clone) "
    else
      list_cmd=$(printf '%q --list-branches %q' "$SELF" "$dir")
      btitle=" worktree from $(pretty "$dir") "
    fi
    picked=$(bash -c "$list_cmd" | fzf --ansi --tiebreak=index --delimiter="$TAB" --with-nth=2 \
      --print-query --expect=alt-enter \
      --bind="ctrl-r:reload($list_cmd fetch)" \
      --prompt='branch> ' --border-label="$btitle" \
      --header='enter: pick (or type a new name)  ·  alt-enter: use typed name  ·  ctrl-r: fetch  ·  esc: back')
    if [ $? -eq 130 ]; then step=where; continue; fi
    bquery=$(sed -n 1p <<<"$picked")
    bkey=$(sed -n 2p <<<"$picked")
    brow=$(sed -n 3p <<<"$picked")
    if [ "$bkey" = alt-enter ] || [ -z "$brow" ]; then branch=$bquery; else branch=${brow%%"$TAB"*}; fi
    [ -n "$branch" ] && step=agent
    ;;
  agent)
    if [ -n "$shell_mode" ]; then agent=""; break; fi
    agent=$(printf '%s\n' "${agents[@]}" | fzf --tiebreak=index --prompt='agent> ' \
      --border-label="$title" --header='enter: start  ·  esc: back')
    if [ -n "$agent" ]; then break; fi
    if [ -n "$branch" ]; then step=branch; else step=where; fi
    ;;
  esac
done

if [ -n "$agent" ]; then
  mkdir -p "$STATE_DIR" && printf '%s\n' "$agent" >"$LAST_AGENT_FILE"
fi
cmd=$agent
label=""

if [ "$kind" = remote ]; then
  # Clone in a new workspace's pane, then carry on there: start the agent, or
  # hand over to --after-clone to make the worktree for the picked branch.
  name_only=${dir#*/}
  [ -e "$CLONE_DIR/$name_only" ] && fail "$(pretty "$CLONE_DIR/$name_only") already exists"
  mkdir -p "$CLONE_DIR" || fail "could not create $(pretty "$CLONE_DIR")"
  cmd=$(printf 'git clone --filter=blob:none %q %q && cd %q' \
    "$(clone_url "$dir")" "$name_only" "$name_only")
  if [ -n "$branch" ]; then
    default=$(git ls-remote --symref "$(clone_url "$dir")" HEAD 2>/dev/null |
      sed -n 's#^ref: refs/heads/\(.*\)\tHEAD$#\1#p')
  fi
  if [ -n "$branch" ] && [ "$branch" != "${default:-}" ]; then
    cmd+=$(printf ' && %q --after-clone %q %q && exit' "$SELF" "$branch" "$agent")
  elif [ -n "$agent" ]; then
    cmd+=" && $agent"
  fi
  mode=workspace dir=$CLONE_DIR label=$name_only target_ws=""
elif [ -n "$branch" ]; then
  resolve_branch
elif [ -n "$target_ws" ]; then
  mode=tab
else
  mode=workspace
fi

launch
exit 0
