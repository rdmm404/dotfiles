#!/usr/bin/env bash
# Manage visible OpenCode child agents in Herdr via hc + herdr-app + opencode api.
#
# Subcommands:
#   spawn      --dir <dir> --name <name> [--space <id>] [--tab <id>] [--model <p/id#var>] [--agent <name>] [--prompt <text> | --prompt-file <file>]
#   send       <target> [--wait] [--if idle|working] [--force] [--timeout S] [--prompt-file <file> | <text>]
#   wait       [target | --children any|all] [--timeout S]
#   status     [target]
#   read       <target> [--lines N]
#   keys       <target> <keys...>
#   interrupt  <target>
#   kill       <target>
set -euo pipefail

die() { printf 'herdr-agent: %s\n' "$*" >&2; exit 2; }

slugify() {
  local s
  s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9_-' '-' | sed 's/^[^a-z0-9]*//; s/-*$//' | cut -c1-32)
  printf '%s' "${s:-agent}"
}

current_space() {
  command -v herdr-app >/dev/null 2>&1 || return 0
  local ls
  ls=$(herdr-app ls 2>/dev/null) || return 0
  if [[ -n "${HC_TERMINAL_ID:-}" ]]; then
    printf '%s' "$ls" | jq -r --arg t "$HC_TERMINAL_ID" '
      .spaces[] | select(.tabs[]?.terminals[]?.terminal == $t) | .id' | head -n 1
  else
    printf '%s' "$ls" | jq -r '.spaces[] | select(.active) | .id' | head -n 1
  fi
}

cmd_spawn() {
  local model="google-vertex/claude-sonnet-5-5@default#medium"
  local dir="" name="" space="" tab="" agent="" prompt="" prompt_file="" session="" report_hint=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      --name) name="$2"; shift 2 ;;
      --space) space="$2"; shift 2 ;;
      --tab) tab="$2"; shift 2 ;;
      --model) model="$2"; shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --prompt) prompt="$2"; shift 2 ;;
      --prompt-file) prompt_file="$2"; shift 2 ;;
      --session) session="$2"; shift 2 ;;
      --no-report-hint) report_hint=0; shift ;;
      *) die "unknown spawn arg: $1" ;;
    esac
  done

  [[ -n "$dir" && -n "$name" ]] || die "spawn requires --dir and --name"
  if [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || die "prompt file not found: $prompt_file"
    prompt=$(cat "$prompt_file")
  fi

  local provider="${model%%/*}"
  local rest="${model#*/}"
  local id="${rest%%#*}"
  local variant=""
  [[ "$rest" == *"#"* ]] && variant="${rest#*#}"

  local body
  if [[ -z "$session" ]]; then
    body=$(jq -n \
      --arg t "$name" \
      --arg p "$provider" \
      --arg i "$id" \
      --arg v "$variant" \
      --arg d "$dir" \
      --arg a "$agent" \
      '{title: $t, location: {directory: $d}, model: ({providerID: $p, id: $i} + (if $v == "" then {} else {variant: $v} end))} + (if $a == "" then {} else {agent: $a} end)')

    session=$(opencode api post /api/session --data "$body" | jq -r '.data.id')
  fi
  [[ "$session" == ses* ]] || die "session create failed"

  if [[ -z "$space" && -z "$tab" ]]; then
    space=$(current_space)
  fi

  if [[ -n "$prompt" && "$report_hint" == 1 && -n "${HC_TERMINAL_ID:-}" ]]; then
    if [[ "$prompt" != *"hc send $HC_TERMINAL_ID"* ]]; then
      prompt="$prompt

Report back with \`hc send $HC_TERMINAL_ID \"<summary or blocker>\"\` when done or stuck."
    fi
  fi

  local slug
  slug=$(slugify "$name")

  local hc_args=(--bg --json --name "$slug" --cwd "$dir")
  [[ -n "$space" ]] && hc_args+=(--label "herdr.space=$space")
  [[ -n "$tab" ]] && hc_args+=(--label "herdr.tab=$tab")

  # hc starts programs with the holder's bare launchd env; an interactive shell loads the zshrc exports (GITHUB_TOKEN etc.)
  local cmd_args=("${SHELL:-/bin/zsh}" -ic 'exec "$@"' herdr-agent opencode -s "$session")
  [[ -n "$prompt" ]] && cmd_args+=(--prompt "$prompt")

  local run_out addr
  run_out=$(hc run "${hc_args[@]}" "${cmd_args[@]}")
  addr=$(printf '%s' "$run_out" | jq -r '.address')

  jq -n \
    --arg terminal "$addr" \
    --arg name "$slug" \
    --arg session "$session" \
    --arg space "$space" \
    --arg tab "$tab" \
    '{terminal: $terminal, name: $name, session: $session}
     + (if $space == "" then {} else {space: $space} end)
     + (if $tab == "" then {} else {tab: $tab} end)'
}

cmd_send() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "send requires <target>"
  shift

  local opts=() prompt="" prompt_file=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait|--force) opts+=("$1"); shift ;;
      --if|--timeout) opts+=("$1" "$2"); shift 2 ;;
      --prompt-file) prompt_file="$2"; shift 2 ;;
      -*) die "unknown send arg: $1" ;;
      *) [[ -z "$prompt" ]] || die "unexpected extra arg: $1"; prompt="$1"; shift ;;
    esac
  done

  if [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || die "prompt file not found: $prompt_file"
    prompt=$(cat "$prompt_file")
  fi
  [[ -n "$prompt" ]] || die "send requires text or --prompt-file"

  # bash 3.2 (macOS) treats an empty array as unbound under set -u
  hc send --json ${opts[@]+"${opts[@]}"} "$target" "$prompt"
}

cmd_wait() {
  local args=(--json)
  local has_target_or_children=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --children) args+=(--children "$2"); has_target_or_children=1; shift 2 ;;
      --timeout) args+=(--timeout "$2"); shift 2 ;;
      -*) die "unknown wait arg: $1" ;;
      *) args+=("$1"); has_target_or_children=1; shift ;;
    esac
  done
  [[ "$has_target_or_children" == 1 ]] || args+=(--children any)
  hc wait "${args[@]}"
}

cmd_status() {
  if [[ $# -eq 0 ]]; then
    hc ls --json
  else
    hc get --json "$1"
  fi
}

cmd_read() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "read requires <target>"
  shift
  local lines=80
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lines) lines="$2"; shift 2 ;;
      *) die "unknown read arg: $1" ;;
    esac
  done
  hc read --lines "$lines" "$target"
}

cmd_keys() {
  local target="${1:-}"
  [[ -n "$target" && $# -ge 2 ]] || die "keys requires <target> <keys...>"
  shift
  hc keys "$target" "$@"
}

cmd_interrupt() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "interrupt requires <target>"
  hc interrupt --json "$target"
}

cmd_kill() {
  local target="${1:-}"
  [[ -n "$target" ]] || die "kill requires <target>"
  hc kill "$target" >/dev/null 2>&1 || true
  hc rm --json "$target"
}

sub="${1:-}"
[[ -n "$sub" ]] || { sed -n '2,12p' "$0" >&2; exit 2; }
shift

case "$sub" in
  spawn) cmd_spawn "$@" ;;
  send) cmd_send "$@" ;;
  wait) cmd_wait "$@" ;;
  status) cmd_status "$@" ;;
  read) cmd_read "$@" ;;
  keys) cmd_keys "$@" ;;
  interrupt) cmd_interrupt "$@" ;;
  kill) cmd_kill "$@" ;;
  -h|--help|help) sed -n '2,12p' "$0" ;;
  *) die "unknown subcommand: $sub" ;;
esac
