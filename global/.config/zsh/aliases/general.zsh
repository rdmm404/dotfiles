alias j='cd'
alias f='cdi'
alias lg='lazygit'
alias nvimrc='nvim ~/.config/nvim/'
alias nman='bob'

# Confirm before overwriting something.
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# Easier-to-read disk and process summaries.
alias df='df -h'
alias psmem='ps auxf | sort -nr -k 4 | head -5'
alias pscpu='ps auxf | sort -nr -k 3 | head -5'
