export EDITOR='nano'
export XDG_CONFIG_HOME="$HOME/.config"
export HERDR_LAUNCH_OWNERS=rdmm404
export HERDR_LAUNCH_CLONE_DIR="$HOME/Projects"
# herdr-worktree puts checkouts in $WORKTREES_DIR/<repo>/<branch> (default ~/worktrees).
# Set it in a machine's local shell config to put them elsewhere.

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.docker/bin:$PATH"

export GOPATH="$HOME/go"
export PATH="$PATH:$GOPATH/bin"

export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
