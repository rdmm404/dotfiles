#!/usr/bin/env bash

DOT_ROOT=${DOT_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export DOT_ROOT

. "$DOT_ROOT/lib/cli.sh" || exit 1
. "$DOT_ROOT/lib/platform.sh" || exit 1
. "$DOT_ROOT/lib/apps.sh" || exit 1
. "$DOT_ROOT/lib/manifest.sh" || exit 1
. "$DOT_ROOT/lib/install.sh" || exit 1
. "$DOT_ROOT/lib/backups.sh" || exit 1
. "$DOT_ROOT/lib/deploy.sh" || exit 1
. "$DOT_ROOT/lib/doctor.sh" || exit 1

plan_command() {
  include_optional=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --include)
        [ "$#" -ge 2 ] || { dot_bad_args 'missing value for --include' plan; return $?; }
        [ "$2" = optional ] || { dot_bad_args "unsupported include value: $2" plan; return $?; }
        include_optional=1
        shift 2
        ;;
      --help|-h)
        dot_command_usage plan
        return 0
        ;;
      *)
        dot_bad_args "invalid argument: $1" plan
        return $?
        ;;
    esac
  done

  install_prepare "$include_optional" || return 1
  install_print_header "$include_optional"
  install_plan || return 1
  deploy_plan_command || return 1
}

install_command_with_args() {
  include_optional=0
  yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --include)
        [ "$#" -ge 2 ] || { dot_bad_args 'missing value for --include' install; return $?; }
        [ "$2" = optional ] || { dot_bad_args "unsupported include value: $2" install; return $?; }
        include_optional=1
        shift 2
        ;;
      --yes)
        yes=1
        shift
        ;;
      --help|-h)
        dot_command_usage install
        return 0
        ;;
      *)
        dot_bad_args "invalid argument: $1" install
        return $?
        ;;
    esac
  done
  install_command "$include_optional" "$yes"
}

deploy_command_with_args() {
  deploy_command "$@"
}

undeploy_command_with_args() {
  yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --help|-h) dot_command_usage undeploy; return 0 ;;
      *) dot_bad_args "invalid argument: $1" undeploy; return $? ;;
    esac
  done
  deploy_undeploy_command "$yes"
}

backups_command_with_args() {
  [ "$#" -gt 0 ] || { dot_bad_args 'missing backups subcommand' backups; return $?; }
  backups_subcommand="$1"
  shift
  case "$backups_subcommand" in
    list)
      [ "$#" = 0 ] || { dot_bad_args "invalid argument: $1" 'backups list'; return $?; }
      backups_list_command
      ;;
    restore)
      [ "$#" -gt 0 ] || { dot_bad_args 'missing backup timestamp' 'backups restore'; return $?; }
      backups_restore_command "$@"
      ;;
    remove)
      [ "$#" -gt 0 ] || { dot_bad_args 'missing backup timestamp' 'backups remove'; return $?; }
      backups_remove_command "$@"
      ;;
    prune)
      backups_prune_command "$@"
      ;;
    *)
      dot_bad_args "unknown backups subcommand: $backups_subcommand" backups
      ;;
  esac
}

bootstrap_command_with_args() {
  include_optional=0
  yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --include)
        [ "$#" -ge 2 ] || { dot_bad_args 'missing value for --include' bootstrap; return $?; }
        [ "$2" = optional ] || { dot_bad_args "unsupported include value: $2" bootstrap; return $?; }
        include_optional=1
        shift 2
        ;;
      --yes)
        yes=1
        shift
        ;;
      --help|-h)
        dot_command_usage bootstrap
        return 0
        ;;
      *)
        dot_bad_args "invalid argument: $1" bootstrap
        return $?
        ;;
    esac
  done
  bootstrap_command "$include_optional" "$yes"
}

case "${1:-help}" in
  help|--help|-h)
    if [ "$#" -gt 1 ]; then
      dot_command_usage "$2"
    else
      dot_usage
    fi
    ;;
  doctor)
    shift
    [ "$#" = 0 ] || dot_bad_args "invalid argument: $1" doctor || exit $?
    doctor_command
    ;;
  plan)
    shift
    plan_command "$@"
    ;;
  install)
    shift
    install_command_with_args "$@"
    ;;
  bootstrap)
    shift
    bootstrap_command_with_args "$@"
    ;;
  deploy)
    shift
    deploy_command_with_args "$@"
    ;;
  undeploy)
    shift
    undeploy_command_with_args "$@"
    ;;
  backups)
    shift
    backups_command_with_args "$@"
    ;;
  *)
    dot_error "unknown command: $1"
    dot_usage >&2
    exit 2
    ;;
esac
