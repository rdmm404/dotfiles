#!/usr/bin/env bash

# Resolve a symlinked entry point unless DOT_ROOT was supplied by a caller.
# This keeps installed symlinks pointing at the repository usable without a
# platform-specific readlink extension.
if [ -z "${DOT_ROOT:-}" ]; then
  dot_entry="$0"
  case "$dot_entry" in
    /*) ;;
    *) dot_entry="$(pwd)/$dot_entry" ;;
  esac
  while [ -L "$dot_entry" ]; do
    dot_link="$(readlink "$dot_entry" 2>/dev/null)" || break
    case "$dot_link" in
      /*) dot_entry="$dot_link" ;;
      *) dot_entry="$(dirname "$dot_entry")/$dot_link" ;;
    esac
  done
  DOT_ROOT=$(CDPATH= cd -- "$(dirname "$dot_entry")" 2>/dev/null && pwd) || exit 1
fi
export DOT_ROOT

. "$DOT_ROOT/lib/cli.sh" || exit 1
. "$DOT_ROOT/lib/platform.sh" || exit 1
. "$DOT_ROOT/lib/apps.sh" || exit 1
. "$DOT_ROOT/lib/manifest.sh" || exit 1
. "$DOT_ROOT/lib/install.sh" || exit 1
. "$DOT_ROOT/lib/doctor.sh" || exit 1

install_command_with_args() {
  install_include=0
  install_dry_run=0
  install_verbose=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --include)
        [ "$#" -ge 2 ] || { dot_bad_args 'missing value for --include' install; return $?; }
        [ "$2" = optional ] || { dot_bad_args "unsupported include value: $2" install; return $?; }
        install_include=1
        shift 2
        ;;
      --dry-run) install_dry_run=1; shift ;;
      --verbose) install_verbose=1; shift ;;
      --help|-h) dot_command_usage install; return 0 ;;
      *) dot_bad_args "invalid argument: $1" install; return $? ;;
    esac
  done
  install_command "$install_include" "$install_dry_run" "$install_verbose"
}

bootstrap_command_with_args() {
  bootstrap_include=0
  bootstrap_dry_run=0
  bootstrap_verbose=0
  bootstrap_replace=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --include)
        [ "$#" -ge 2 ] || { dot_bad_args 'missing value for --include' bootstrap; return $?; }
        [ "$2" = optional ] || { dot_bad_args "unsupported include value: $2" bootstrap; return $?; }
        bootstrap_include=1
        shift 2
        ;;
      --dry-run) bootstrap_dry_run=1; shift ;;
      --verbose) bootstrap_verbose=1; shift ;;
      --replace) bootstrap_replace=1; shift ;;
      --help|-h) dot_command_usage bootstrap; return 0 ;;
      *) dot_bad_args "invalid argument: $1" bootstrap; return $? ;;
    esac
  done
  bootstrap_command "$bootstrap_include" "$bootstrap_dry_run" "$bootstrap_verbose" "$bootstrap_replace"
}

doctor_command_with_args() {
  doctor_verbose=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --verbose) doctor_verbose=1; shift ;;
      --help|-h) dot_command_usage doctor; return 0 ;;
      *) dot_bad_args "invalid argument: $1" doctor; return $? ;;
    esac
  done
  doctor_command "$doctor_verbose"
}

deploy_command_with_args() {
  files_command deploy "$@"
}

undeploy_command_with_args() {
  files_command undeploy "$@"
}

add_command_with_args() {
  files_command add "$@"
}

backups_command_with_args() {
  files_command backups "$@"
}

case "${1:-help}" in
  help|--help|-h)
    if [ "$#" -gt 1 ]; then
      shift
      dot_command_usage "$*"
    else
      dot_usage
    fi
    ;;
  doctor)
    shift
    doctor_command_with_args "$@"
    ;;
  install)
    shift
    install_command_with_args "$@"
    ;;
  bootstrap)
    shift
    bootstrap_command_with_args "$@"
    ;;
  deploy)
    shift
    deploy_command_with_args "$@"
    ;;
  undeploy)
    shift
    undeploy_command_with_args "$@"
    ;;
  add)
    shift
    add_command_with_args "$@"
    ;;
  backups)
    shift
    backups_command_with_args "$@"
    ;;
  *)
    dot_error "unknown command: $1"
    dot_usage >&2
    exit 2
    ;;
esac
